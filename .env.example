# ---------------------------------------------------------------------------
# DevOps Demand Management POC - configuration
# Copy to .env and adjust:   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- Image versions (pinned for reproducibility) ----
YOUTRACK_VERSION=2026.2.19422
GITLAB_VERSION=19.4.1-ce.0
GITLAB_RUNNER_VERSION=alpine-v19.4.1
MAILPIT_VERSION=v1.27
NGINX_VERSION=1.27-alpine
PYTHON_VERSION=3.12-alpine

# ---- YouTrack ----
YOUTRACK_PORT=8080
# URL users type in their browser (used in links, emails, GitLab integration)
YOUTRACK_BASE_URL=http://localhost:8080
YOUTRACK_HEAP=2g
# The built-in "admin" account starts with password "admin"; setup.sh replaces it with:
YOUTRACK_ADMIN_PASSWORD=ChangeMe-YT-Admin1!
# Password given to all demo users (devops lead, engineers, squad developers)
YOUTRACK_DEMO_USER_PASSWORD=Demo-Pass-2026!
# Project key used for request IDs (DEVOPS-123)
YOUTRACK_PROJECT_KEY=DEVOPS
# Requests open longer than this are flagged "aging" by the workflow (days)
AGING_THRESHOLD_DAYS=14
# Login of the DevOps lead notified about P1/P2 requests
DEVOPS_LEAD_LOGIN=devops.lead

# ---- GitLab CE ----
GITLAB_HTTP_PORT=8929
# Must match the published port. Containers reach GitLab as http://gitlab:<port>.
GITLAB_EXTERNAL_URL=http://localhost:8929
GITLAB_SSH_PORT=2224
GITLAB_ROOT_PASSWORD=Xq7-vNd2-Lp9w-Tz4k
# Personal access token created for root by setup.sh (gitlab-rails runner).
# Must start with "glpat-" and be 20+ chars. CHANGE for anything beyond a laptop.
GITLAB_ROOT_TOKEN=glpat-devopspoc-change-me-0001
GITLAB_DEMO_GROUP=platform
GITLAB_DEMO_PROJECT=ci-templates

# ---- Mailpit (SMTP sink: shows the e-mails YouTrack workflows send) ----
MAILPIT_UI_PORT=8025

# ---- Demo deployment target ----
DEMO_APP_PORT=8088

# ---- GitLab Runner ----
# Helper image used by the docker executor (Docker Hub mirror of registry.gitlab.com's image).
# Point to your internal registry for air-gapped installs.
GITLAB_RUNNER_HELPER_IMAGE=gitlab/gitlab-runner-helper:x86_64-v19.4.1
